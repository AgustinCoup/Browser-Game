# Copiá a .env y completá. .env NO se commitea.
SECRET_KEY=cambiame
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=mysql://tablon:tablon@127.0.0.1:3306/tablon

# Solo para docker compose (el servicio db y la DATABASE_URL del servicio web se arman con esto)
MYSQL_DATABASE=tablon
MYSQL_USER=tablon
MYSQL_PASSWORD=tablon
MYSQL_ROOT_PASSWORD=root
